RM = rm -f
CC = gcc
#FLAGS_MLX = -Lmlx -lmlx_Linux -Llibft -lft -lXext -lX11 -lm -lz #-g3 -fsanitize=address
FLAGS_MLX = -lmlx -framework OpenGL -framework AppKit
FLAGS = -Wall -Wextra -Werror -g

LIBFT = -L libft -lft

NAME = Cube3d
OBJ_DIR = objetos

SRC = main.c render.c vector3.c keys.c check_extension.c open_map.c initialize_character.c \
		check_map_validation.c duplicate_map.c floodfill.c rotate_vector2.c

OBJ = $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC))

$(OBJ_DIR)/%.o: %.c
	$(CC) $(FLAGS) $(FLAGS_MLX) -c -o $@ $<

all: $(NAME)

$(NAME): $(OBJ)
	make -C libft
	$(CC) $(OBJ) $(FLAGS) $(FLAGS_MLX) $(LIBFT) -o $(NAME)

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(OBJ): | $(OBJ_DIR)

clean:
	$(RM) $(OBJ)
	make clean -C libft

fclean: clean
	$(RM) $(NAME)
	make fclean -C libft

re: fclean all

.PHONY: all clean fclean re
